{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://descente-canyon.app/schemas/app-canyon.schema.json",
  "title": "App Canyon",
  "type": "object",
  "required": [
    "sourceKey",
    "name",
    "country",
    "rating",
    "description"
  ],
  "properties": {
    "sourceKey": {
      "type": "string",
      "pattern": "^app:[a-z0-9-]+$"
    },
    "runtimeId": {
      "type": "integer",
      "minimum": 1000000
    },
    "name": { "type": "string", "minLength": 1 },
    "fullName": { "type": "string" },
    "country": { "type": "string", "minLength": 1 },
    "region": { "type": "string" },
    "department": { "type": "string" },
    "municipality": { "type": "string" },
    "communes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "massif": { "type": "string" },
    "basin": { "type": "string" },
    "watercourse": { "type": "string" },
    "rating": {
      "type": "object",
      "required": ["verticality", "aquatic", "engagement"],
      "properties": {
        "verticality": { "type": "integer", "minimum": 1, "maximum": 9 },
        "aquatic": { "type": "integer", "minimum": 1, "maximum": 9 },
        "engagement": { "type": "integer", "minimum": 1, "maximum": 9 }
      },
      "additionalProperties": false
    },
    "altitudeStart": { "type": "integer", "minimum": 0 },
    "elevation": { "type": "integer", "minimum": 0 },
    "length": { "type": "integer", "minimum": 0 },
    "maxWaterfall": { "type": "integer", "minimum": 0 },
    "minRope": { "type": "integer", "minimum": 0 },
    "approachTime": { "type": "string" },
    "descentTime": { "type": "string" },
    "returnTime": { "type": "string" },
    "hasShuttle": { "type": "boolean" },
    "interest": { "type": "integer", "minimum": 0, "maximum": 4 },
    "description": { "type": "string", "minLength": 1 },
    "accessDownstream": { "type": "string" },
    "accessUpstream": { "type": "string" },
    "approach": { "type": "string" },
    "descent": { "type": "string" },
    "returnRoute": { "type": "string" },
    "period": { "type": "string" },
    "geology": { "type": "string" },
    "history": { "type": "string" },
    "remarks": { "type": "string" },
    "geoPoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/geoPoint" }
    },
    "watershed": { "$ref": "#/$defs/watershed" },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "geoPoint": {
      "type": "object",
      "required": ["type", "latitude", "longitude"],
      "properties": {
        "type": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "title": { "type": "string" },
        "remark": { "type": "string" }
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "file"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "file": { "type": "string", "minLength": 1 },
        "isPrimary": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "watershed": {
      "type": "object",
      "properties": {
        "areaKm2": { "type": "number", "minimum": 0 },
        "polygonFile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
