<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS-only: forbid cleartext HTTP so session cookies can never be sent in plaintext,
     even if a server redirects https:// descente-canyon.com onto an http:// endpoint. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
