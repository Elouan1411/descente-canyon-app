<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-backup / device-to-device (API 30+). Exclude encrypted auth prefs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dc_auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dc_auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
