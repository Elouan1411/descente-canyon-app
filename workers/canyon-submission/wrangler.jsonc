{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Must match the Worker name configured in the Cloudflare dashboard.
  "name": "canyon-submission-api",
  "main": "src/index.js",
  "compatibility_date": "2026-04-08",

  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,

  "observability": {
    "enabled": true
  },

  "secrets": {
    "required": ["GITHUB_TOKEN"]
  }
}
